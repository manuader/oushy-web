# Instagram Graph API — powers the "el feed" carousel.
#
# Requires an Instagram Professional account (Business or Creator). The old
# Basic Display API was shut down in December 2024, so the token must come from
# Instagram Login: https://developers.facebook.com/docs/instagram-platform
#
# Long-lived tokens last 60 days and must be refreshed before they expire:
#   curl -s "https://graph.instagram.com/refresh_access_token\
# ?grant_type=ig_refresh_token&access_token=$INSTAGRAM_ACCESS_TOKEN"
#
# Leave unset and the feed falls back to placeholder tiles.
INSTAGRAM_ACCESS_TOKEN=
